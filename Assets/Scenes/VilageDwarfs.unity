  m_Script: {fileID: 11500000, guid: 2b98cda74182d4cc7a07b1248f7327b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroSequence
  panelCanvasGroup: {fileID: 1250361271}
  loreText: {fileID: 1824133552}
  loreLines:
  - This world was not a peaceful one.
  - "Humans, dwarves, elves and orcs\nhad always lived side by side\u2026\nbut never
    together."
  - Each race believed itself to be in the right.
  - Each race believed itself to be in the right.
  - Each believed itself to be better than the rest.
  - "And the world was held together not by peace\u2026\nbut by hatred."
  - '[Shots of cities / mines / forests]'
  - Until one day they discovered magic.
  - Not a miracle.
  - Not salvation.
  - But power.
  - At first it healed.
  - Then it killed.
  - Kings waged war for power.
  - Mages for control.
  - Ordinary people for survival.
  - '[Footage of destruction, war, orcs]'
  - And then the world broke apart for good.
  - The orcs were the first to embrace the darkness.
  - And became its weapon.
  - The elves split apart.
  - Humans lost their kingdoms.
  - The dwarves sealed their fortresses.
  - '[Silence / black screen]'
  - Now the world is not dying.
  - It is simply continuing to crumble.
  - '[Shot: Dwarf village / mine / player]'
  - You are no hero.
  - No prophecy.
  - 'You are simply alive.

'
  - "And that is enough\u2026 to begin the journey."
  charDelay: 0.04
  readTime: 3
  textFadeInTime: 0.5
  textFadeOutTime: 0.7
  panelFadeOutTime: 0.8
  delayBetweenLines: 0.3
  onIntroFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1673482072}
        m_TargetAssemblyTypeName: CutscenePlayer, Assembly-CSharp
        m_MethodName: PlayCutscene
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  forcePlayIntro: 0
