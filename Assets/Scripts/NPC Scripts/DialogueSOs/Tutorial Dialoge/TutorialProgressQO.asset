  m_Script: {fileID: 11500000, guid: 3774526d0d46ec1469e9bf78c7bd36e1, type: 3}
  m_Name: TutorialProgressQO
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: Strength is not only muscle.
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: 'Every battle gives experience.

      Every victory gives you
      a chance to grow stronger.'
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: 'Choose wisely. Power, health, speed...

      A fool improves
      everything and masters nothing.'
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: 'Go to my brother, Bjorik.

      He teaches movement faster than
      I do, and louder too.'
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: "He\u2019s not far from the courtyard; when you go out, turn right
      behind the courtyard\u2014he lives there."
  - speaker: {fileID: 11400000, guid: f1a8aa03c0e5449f8bc936dfdfb82089, type: 2}
    dialogueText: Learn the dash from him. Then return.
  options: []
