  lines:
  - speaker: {fileID: 11400000, guid: 11db11e715e95584b815a631973040c7, type: 2}
    dialogueText: 'My brother has gone somewhere! Now have to search for him all
      day, and we have orders to fulfil. '
  - speaker: {fileID: 11400000, guid: 11db11e715e95584b815a631973040c7, type: 2}
    dialogueText: 'Oh well... I''ll start by checking the northern part of the city,
      and then I''ll go south.  '
