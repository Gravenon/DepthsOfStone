  lines:
  - speaker: {fileID: 11400000, guid: 11db11e715e95584b815a631973040c7, type: 2}
    dialogueText: Hello, Player!
  - speaker: {fileID: 11400000, guid: 11db11e715e95584b815a631973040c7, type: 2}
    dialogueText: 'This dialogue should not be just a test to see if everything works. '
  - speaker: {fileID: 11400000, guid: b7ee7ee5d334dce4c837283e155f29a9, type: 2}
    dialogueText: Seriously, then why are we talking now?
