  m_TableData:
  - m_Id: 16771387392
    m_Localized: "Pionieru priek\u0161postenis"
    m_Metadata:
      m_Items: []
  - m_Id: 152683614208
    m_Localized: "Raktuvju sen\u0101k\u0101 da\u013Ca, kur r\u016B\u0137i s\u0101ka
      ieguvi p\u0113c apmetnes dibin\u0101\u0161anas. Dro\u0161i tune\u013Ci, vecas
      nometnes un vienk\u0101r\u0161i dzelzs atradumi."
    m_Metadata:
      m_Items: []
  - m_Id: 1267668029440
    m_Localized: "Pazemes dzi\u013Cumu appl\u016Bdu\u0161\u0101 l\u012Bc\u012B"
    m_Metadata:
      m_Items: []
  - m_Id: 1267668029441
    m_Localized: "Senu tune\u013Cu t\u012Bkls, kas da\u013C\u0113ji appl\u016Bdis
      p\u0113c tam, kad pazemes ezers p\u0101rpl\u016Bda. \u0160eit, appl\u016Bdu\u0161aj\u0101s
      al\u0101s, tiek ieguvi reti krist\u0101li un d\u0101rgmet\u0101li."
    m_Metadata:
      m_Items: []
  - m_Id: 1267668029442
    m_Localized: "Akmens me\u017Es"
    m_Metadata:
      m_Items: []
  - m_Id: 1267668029443
    m_Localized: "Nosl\u0113pumaina teritorija dzi\u013Ci zem kalna, kas piepild\u012Bta
      ar milz\u012Bg\u0101m akmens kolonn\u0101m, kas atg\u0101dina senus kokus.
      Starp t\u0101m sl\u0113pjas visret\u0101kie resursi un b\u012Bstamas b\u016Btnes."
    m_Metadata:
      m_Items: []
  - m_Id: 4578303479808
    m_Localized: 
