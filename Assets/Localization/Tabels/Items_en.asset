    m_Localized: Roast rabbit, Dwarf-style
    m_Metadata:
      m_Items: []
  - m_Id: 16436779487244
    m_Localized: "Old Man Boromir\u2019s Bucket"
    m_Metadata:
      m_Items: []
  - m_Id: 16436779487245
    m_Localized: "The Blacksmith\u2019s Brother\u2019s Helmet"
    m_Metadata:
